# Single env file for the local Docker stack (docker-compose.yml).
# Server deployments use deploy/.env (see deploy/.env.example) with the same keys.

# --- be-nest ---
BE_NEST_NODE_ENV=production
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8081
# Comma-separated browser origins allowed by CORS, Better Auth and Socket.IO.
APP_ORIGIN=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Shared MinIO from the existing "convocation" stack ---
SHARED_NETWORK=convocation_convocation
S3_ACCESS_KEY=replace-with-shared-MINIO_ROOT_USER
S3_SECRET_KEY=replace-with-shared-MINIO_ROOT_PASSWORD
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_BUCKET=convocation

# --- fe (runtime, server-only) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
