{
  "version": 1,
  "basePath": "/api",
  "messageLocale": "vi-VN",
  "errorEnvelope": { "required": ["code", "message"], "optional": ["details"] },
  "roleCodes": ["MN", "CK", "MC", "US", "NO"],
  "permissions": ["system.manage", "halls.manage", "sessions.manage", "bachelors.manage", "checkin.execute", "led.control", "notifications.manage", "notifications.broadcast", "media.manage"],
  "routes": [
    { "method": "GET", "path": "/auth/csrf", "auth": "public", "owner": "auth", "quirk": "compatibility no-op 204" },
    { "method": "POST", "path": "/auth/login", "auth": "public", "owner": "auth", "sideEffects": ["create-session", "legacy-hash-rehash"] },
    { "method": "POST", "path": "/auth/logout", "auth": "session", "owner": "auth", "sideEffects": ["revoke-session"] },
    { "method": "GET", "path": "/auth/me", "auth": "session", "owner": "auth" },
    { "method": "POST", "path": "/auth/password", "auth": "session", "owner": "auth", "sideEffects": ["revoke-other-sessions"] },
    { "method": "POST", "path": "/auth/password/reset/request", "auth": "public", "owner": "auth" },
    { "method": "POST", "path": "/auth/password/reset/confirm", "auth": "public", "owner": "auth", "sideEffects": ["revoke-sessions"] },

    { "method": "GET", "path": "/Hall/GetAll", "auth": "public", "owner": "hall" },
    { "method": "POST", "path": "/Hall/CreateHall", "auth": "halls.manage", "owner": "hall" },
    { "method": "PUT", "path": "/Hall/UpdateHall/:hallId", "auth": "halls.manage", "owner": "hall" },
    { "method": "DELETE", "path": "/Hall/DeleteHall/:hallId", "auth": "halls.manage", "owner": "hall" },
    { "method": "GET", "path": "/Session/GetAll", "auth": "public", "owner": "session" },
    { "method": "POST", "path": "/Session/CreateSession", "auth": "sessions.manage", "owner": "session" },
    { "method": "PUT", "path": "/Session/UpdateStatusSession/:sessionId", "auth": "sessions.manage", "owner": "session" },
    { "method": "DELETE", "path": "/Session/DeleteSession/:sessionId", "auth": "sessions.manage", "owner": "session" },
    { "method": "POST", "path": "/Session/AutoFillSessionInDay", "auth": "sessions.manage", "owner": "session" },
    { "method": "GET", "path": "/Statistics/active-halls-summary", "auth": "public", "owner": "statistics" },
    { "method": "GET", "path": "/Statistics/hall-overview", "auth": "public", "owner": "statistics" },

    { "method": "GET", "path": "/Bachelor/search", "auth": "roles:MN,CK,US", "owner": "bachelor" },
    { "method": "GET", "path": "/Bachelor/GetAll", "auth": "roles:MN,CK,US,MC", "owner": "bachelor" },
    { "method": "POST", "path": "/Bachelor/Add", "auth": "bachelors.manage", "owner": "bachelor", "sideEffects": ["bulk-create"] },
    { "method": "PUT", "path": "/Bachelor/Update", "auth": "bachelors.manage", "owner": "bachelor" },
    { "method": "PUT", "path": "/Bachelor/UpdateListBachelor/:hallId/:sessionId", "auth": "bachelors.manage", "owner": "bachelor" },
    { "method": "DELETE", "path": "/Bachelor/Delete/:studentCode", "auth": "bachelors.manage", "owner": "bachelor" },
    { "method": "DELETE", "path": "/Bachelor/DeleteAll", "auth": "bachelors.manage", "owner": "bachelor", "headers": ["X-Confirm-Destructive"] },
    { "method": "PUT", "path": "/Bachelor/ResetStatus", "auth": "bachelors.manage", "owner": "bachelor" },
    { "method": "GET", "path": "/Bachelor/GetByHallSession/:hallId/:sessionId", "auth": "roles:MN", "owner": "bachelor" },
    { "method": "PUT", "path": "/Bachelor/UpdateBachelorToTempSession/:studentCode", "auth": "checkin.execute", "owner": "bachelor" },
    { "method": "PUT", "path": "/Bachelor/TransferLateStudent", "auth": "checkin.execute", "owner": "bachelor" },

    { "method": "PUT", "path": "/Checkin/UpdateCheckin", "auth": "checkin.execute", "owner": "checkin" },
    { "method": "PUT", "path": "/Checkin/UpdateCheckinStudentCode", "auth": "checkin.execute", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetAll", "auth": "checkin.execute", "owner": "checkin" },
    { "method": "PUT", "path": "/Checkin/UncheckAll", "auth": "checkin.execute", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetAllStatusCheckin", "auth": "bachelors.manage", "owner": "checkin" },
    { "method": "PUT", "path": "/Checkin/UpdateStatusCheckin", "auth": "bachelors.manage", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetCountCheckin", "auth": "roles:CK,MN", "owner": "checkin" },
    { "method": "POST", "path": "/Checkin/CreateCheckin", "auth": "checkin.execute", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetListBachelorNotCheckin", "auth": "public", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetListBachelorNotCheckinV2", "auth": "public", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetCheckinStatusFalse", "auth": "public", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/GetStudentsNotCheckedInOpenSessions", "auth": "roles:MN,CK", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/by-hall/:hallId", "auth": "public", "owner": "checkin" },
    { "method": "GET", "path": "/Checkin/by-hall-name", "auth": "public", "owner": "checkin" },

    { "method": "GET", "path": "/Mc/GetLocationBachelor", "auth": "roles:MN,MC,CK", "owner": "led" },
    { "method": "GET", "path": "/Mc/GetAllLocationBachelor", "auth": "roles:MN,MC,CK", "owner": "led" },
    { "method": "GET", "path": "/Mc/GetBachelor1st", "auth": "roles:MN,MC,CK", "owner": "led", "events": ["SendMessage"] },
    { "method": "GET", "path": "/Mc/GetBachelorNext", "auth": "roles:MN,MC,CK", "owner": "led", "events": ["SendMessage"] },
    { "method": "GET", "path": "/Mc/GetBachelorBack", "auth": "roles:MN,MC,CK", "owner": "led", "events": ["SendMessage"] },
    { "method": "GET", "path": "/Mc/GetBachelorCurrent", "auth": "roles:MN,MC,CK", "owner": "led" },

    { "method": "GET", "path": "/Notification", "auth": "session", "owner": "notification" },
    { "method": "GET", "path": "/Notification/pending", "auth": "roles:NO", "owner": "notification" },
    { "method": "GET", "path": "/Notification/:id", "auth": "session", "owner": "notification" },
    { "method": "POST", "path": "/Notification", "auth": "notifications.manage", "owner": "notification" },
    { "method": "PUT", "path": "/Notification/:id", "auth": "notifications.manage", "owner": "notification" },
    { "method": "DELETE", "path": "/Notification/:id", "auth": "notifications.manage", "owner": "notification" },
    { "method": "POST", "path": "/Notification/:id/start-broadcast", "auth": "notifications.broadcast", "owner": "notification" },
    { "method": "POST", "path": "/Notification/:id/complete", "auth": "notifications.broadcast", "owner": "notification" },
    { "method": "POST", "path": "/Notification/:id/cancel", "auth": "notifications.manage", "owner": "notification" },
    { "method": "POST", "path": "/Notification/:id/broadcast", "auth": "notifications.broadcast", "owner": "notification", "events": ["ReceiveTTSBroadcast"] },

    { "method": "POST", "path": "/media/images", "auth": "media.manage", "owner": "media", "contentType": "multipart/form-data" },
    { "method": "POST", "path": "/media/images/bulk", "auth": "media.manage", "owner": "media", "contentType": "multipart/form-data" },
    { "method": "GET", "path": "/media", "auth": "media.manage", "owner": "media" },
    { "method": "GET", "path": "/media/:id", "auth": "media.manage", "owner": "media" },
    { "method": "GET", "path": "/media/:id/download", "auth": "media.manage", "owner": "media" },
    { "method": "GET", "path": "/media/:id/content", "auth": "media.manage", "owner": "media" },
    { "method": "PATCH", "path": "/media/:id", "auth": "media.manage", "owner": "media" },
    { "method": "DELETE", "path": "/media/:id", "auth": "media.manage", "owner": "media" },
    { "method": "DELETE", "path": "/media", "auth": "media.manage", "owner": "media" },
    { "method": "POST", "path": "/Database/reset-database", "auth": "system.manage", "owner": "database", "headers": ["X-Confirm-Destructive"] }
  ],
  "realtime": {
    "namespace": "/events",
    "authentication": "Better Auth session cookie",
    "serverEvents": ["SendMessage", "ReceiveNotify", "ReceiveTTSBroadcast", "bachelor:changed", "hall:changed", "session:changed", "notification:changed", "authorization:error"],
    "clientCommands": ["SendMessage", "notification:broadcast"],
    "rooms": ["user:<id>", "role:<role>"]
  },
  "frontendConsumers": ["features/session", "features/led", "app/(protected)/notify", "app/(protected)/notification-display"]
}
