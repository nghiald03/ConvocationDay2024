{
  "name": "convocation-backend-nest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test test/integration",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:check": "DATABASE_URL=postgresql://drizzle_check:drizzle_check@localhost:5432/drizzle_check drizzle-kit check",
    "drizzle:migrate": "drizzle-kit migrate",
    "migration": "tsx src/migration/cli.ts",
    "contract:export": "tsx scripts/export-openapi.ts",
    "fixture:sqlserver": "tsx scripts/create-sqlserver-fixture.ts",
    "key:generate": "tsx scripts/generate-auth-secret.ts",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "seed:photo-queue:test": "node scripts/seed-photo-queue-test-data.mjs",
    "patch:photo-queue-retouch": "node scripts/patch-photo-queue-retouch-columns.mjs",
    "secrets:check": "bun ../scripts/secret-check.mjs",
    "verify": "bun run secrets:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run drizzle:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.6",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "mssql": "^12.7.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bun": "^1.4.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
