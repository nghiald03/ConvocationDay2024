{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": "Server=your_dev_server;Database=your_dev_database;User Id=your_dev_user;Password=your_dev_password;Encrypt=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"]
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "Bucket": "convocation",
    "AccessKey": "replace-me",
    "SecretKey": "replace-me",
    "UseSsl": false
  },
  "LegacyMedia": {
    "Roots": ["../imageAPI/uploads", "../fe/uploads"]
  },
  "Operations": {
    "AllowDatabaseReset": false
  }
}
