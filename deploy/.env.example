# Copy to deploy/.env on the server and fill in real values. Never commit deploy/.env.
DOCKERHUB_USER=chalsfptu
# "latest" follows every publish; set a git short SHA to pin a release.
IMAGE_TAG=latest
UPDATE_INTERVAL_SECONDS=120

POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://convocation.example.com
APP_ORIGIN=http://100.68.254.82

# Shared MinIO from the existing "convocation" stack.
SHARED_NETWORK=convocation_convocation
S3_ACCESS_KEY=replace-with-shared-MINIO_ROOT_USER
S3_SECRET_KEY=replace-with-shared-MINIO_ROOT_PASSWORD
S3_PUBLIC_ENDPOINT=image.srofptuhcm.com
S3_BUCKET=convocationday

# Interface the frontend listens on; 127.0.0.1 = only via the cloudflared tunnel.
FE_BIND_ADDRESS=127.0.0.1
FE_PORT=3001
BE_NEST_PORT=8081

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
