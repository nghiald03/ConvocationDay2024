# Browser traffic stays same-origin. Next.js proxies these routes to the API.
API_URL=http://localhost:8081/api
API_ORIGIN=http://localhost:8081
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_REALTIME_ORIGIN=http://localhost:8081

# Server-only TTS configuration. Never prefix secrets with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_ID=replace-me
